# Copy this file to .env and fill it in. .env is never committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any Postgres instance. The free tier of Neon or Supabase is enough.
DATABASE_URL="postgresql://user:password@host/goalpath?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# From https://github.com/settings/developers -> New OAuth App.
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Language model (optional)
# ---------------------------------------------------------------------------
# Both are optional. With neither set the app reads questions with its own
# rules instead, and every feature still works.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Override if the default model is not on your tier.
# GEMINI_MODEL="gemini-2.5-flash"

# Fallback provider. A GitHub personal access token with the models scope.
GITHUB_MODELS_TOKEN=""
# GITHUB_MODELS_MODEL="openai/gpt-4o-mini"

# Most model-backed questions answered per day, across every user. Past it the
# rule-based reader answers instead, so the key cannot be run up. Default 1000.
# AI_DAILY_BUDGET="1000"
